<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and newer. The Claude API key stays out of backups and phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai.xml" />
    </device-transfer>
</data-extraction-rules>
